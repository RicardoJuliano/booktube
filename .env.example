# ── Claude (Anthropic) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── ElevenLabs (TTS) ────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=sk_...

# ── Canal YouTube ────────────────────────────────────────────────────────────
CANAL_NOME=Meu Canal de Livros
CANAL_IDIOMA=pt-BR

# ── YouTube Data API (opcional — para upload automático) ────────────────────
# 1. Crie um projeto em https://console.cloud.google.com/
# 2. Ative "YouTube Data API v3"
# 3. Crie credencial OAuth 2.0 → "Aplicativo de área de trabalho"
# 4. Cole client_id e client_secret abaixo
# 5. Execute: node setup-youtube.js
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── Higgsfield AI (opcional — anima as cenas ilustradas em clipes de vídeo) ──
# 1. Crie uma conta em https://higgsfield.ai/
# 2. Gere uma API key em https://cloud.higgsfield.ai/
# 3. Cole key id e secret abaixo
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# ── TikTok (opcional — habilita upload automático com --cortes) ───────────────

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=


